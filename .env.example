# ==================================================
# Supabase Configuration (REQUIRED)
# ==================================================
# Get these from your Supabase project settings:
# https://app.supabase.com/project/_/settings/api
#
# NEXT_PUBLIC_SUPABASE_URL: Your project's API URL
# NEXT_PUBLIC_SUPABASE_ANON_KEY: Your project's anon/public key (safe for client-side)
#
# IMPORTANT: After setting up your Supabase project:
# 1. Link your project: npx supabase link --project-ref your-project-ref
# 2. Apply migrations: npm run db:push
# 3. Verify RLS policies: Check Supabase dashboard → Database → Tables
# 4. Test auth flow: signup → onboarding → discover
# 5. Verify email settings in Auth → Email Templates (for password reset)
NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ==================================================
# OpenAI Configuration (REQUIRED for Phase 11+)
# ==================================================
# Get your API key from: https://platform.openai.com/api-keys
#
# OPENAI_API_KEY: Server-side only OpenAI API key (never exposed to client)
# OPENAI_MODEL: Model to use for AI explanations (default: gpt-5.6-luna)
#
# Used for grounded AI job match explanation in Phase 11
#
# IMPORTANT: These are used ONLY in API routes (server-side)
# Never expose these to the client - automatically excluded from NEXT_PUBLIC_ vars
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-5.6-luna

# ==================================================
# App Configuration
# ==================================================
# NEXT_PUBLIC_APP_URL: Base URL for your application
# Used for auth redirects and absolute URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
