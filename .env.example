# ==================================================
# Supabase Configuration (REQUIRED)
# ==================================================
# Get these from your Supabase project settings:
# https://app.supabase.com/project/_/settings/api
#
# NEXT_PUBLIC_SUPABASE_URL: Your project's API URL
# NEXT_PUBLIC_SUPABASE_ANON_KEY: Your project's anon/public key (safe for client-side)
# SUPABASE_SERVICE_ROLE_KEY: Your service role key (NEVER expose to client!)
#
# IMPORTANT: After setting up your Supabase project:
# 1. Run migrations: npm run db:push (or via Supabase CLI)
# 2. Verify RLS policies are enabled on all tables
# 3. Test auth flow: signup → onboarding → discover
NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ==================================================
# AI Provider (OPTIONAL - Not used in Phases 1-10)
# ==================================================
# These will be used in future phases for AI features
# Leave as-is for now - not required for core functionality
AI_PROVIDER=openai
AI_API_KEY=your-ai-api-key
AI_MODEL=gpt-4

# ==================================================
# App Configuration
# ==================================================
# NEXT_PUBLIC_APP_URL: Base URL for your application
# Used for auth redirects and absolute URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
